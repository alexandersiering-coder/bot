# Von @BotFather
TELEGRAM_BOT_TOKEN=123456:AA...

# Groq (Default) – Key: https://console.groq.com/keys
LLM_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Alternative: Google Gemini (OpenAI-kompatibler Endpoint)
# LLM_API_KEY=AIza...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# Alternative: OpenAI
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

SYSTEM_PROMPT=Du bist ein hilfsbereiter Assistent in einem Telegram-Chat. Antworte knapp und in der Sprache des Nutzers.
HISTORY_TURNS=10

# PFLICHT: Zugriff ist "fail closed" — ohne Eintrag antwortet der Bot niemandem.
# Der Bot kann Kalender und Einkaufsliste lesen UND ändern; eine offene Instanz
# gäbe jedem Fremden Zugriff darauf.
# Eigene ID: den Bot privat anschreiben, er nennt sie in der Ablehnung.
ALLOWED_USER_IDS=
# Freigeschaltete Gruppen (negative IDs, kommagetrennt). In der Gruppe
# schreiben und die ID aus dem Log ablesen.
ALLOWED_CHAT_IDS=

# Optional: Bring!-Einkaufsliste über den separat deployten Bring-MCP-Server
# (siehe "geteilte einkaufsliste"-Projekt). Beide leer lassen = Feature aus.
BRING_MCP_URL=https://bring-mcp-xxxx.onrender.com/mcp
BRING_MCP_TOKEN=

# Optional: eigenes Modell für Bilder (Text-Default oben kann keine Bilder).
# VISION_MODEL=qwen/qwen3.6-27b
# PDF_MAX_CHARS=15000

# Optional: Erinnerungen & Notizen (Postgres, z. B. kostenlos bei
# https://neon.tech). Leer lassen = Feature aus.
DATABASE_URL=
TIMEZONE=Europe/Berlin

# Optional: wiederkehrende vegane Rezeptvorschläge (Spoonacular, kostenloser
# Tarif ohne Kreditkarte: https://spoonacular.com/food-api/console#Dashboard).
# Leer lassen = Feature aus (Erinnerungen mit kind='vegan_recipe' schlagen fehl).
RECIPE_API_KEY=

# Optional: proaktive Vorschläge in Gruppen (Einkaufsliste/Erinnerungen/
# Notizen), alle X Stunden geprüft. 0 = aus. Braucht BRING_MCP_URL und/oder
# DATABASE_URL, sonst gäbe es nichts vorzuschlagen.
PROACTIVE_INTERVAL_HOURS=0

# Optional: Google-Kalender lesen/schreiben (s. README "Google-Kalender").
# Service-Account-JSON als eine Zeile oder base64-kodiert. Beide leer = aus.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=deine.adresse@gmail.com
